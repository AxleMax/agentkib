{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentKib",
  "version": "0.1.0",
  "identifier": "com.agentkib.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "AgentKib", "width": 1360, "height": 860, "minWidth": 1080, "minHeight": 680, "decorations": true, "transparent": false, "titleBarStyle": "Overlay", "hiddenTitle": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
