{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "AgentKib 主窗口最小权限",
  "windows": ["main", "quota-popover"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
