{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "AgentKib",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 680,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "maximizable": true
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "rpm", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Local asset and context control center for coding agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/agentkib-quota-sidecar"],
    "resources": {
      "resources/linux/": "linux/",
      "resources/licenses/CodexBar-LICENSE.txt": "licenses/CodexBar-LICENSE.txt"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libglib2.0-bin",
          "librsvg2-2",
          "libxdo3"
        ],
        "section": "devel",
        "priority": "optional"
      },
      "rpm": {
        "compression": {
          "type": "zstd",
          "level": 3
        },
        "depends": [
          "gtk3",
          "webkit2gtk4.1",
          "libappindicator-gtk3",
          "librsvg2",
          "libxdo"
        ],
        "release": "1"
      }
    }
  }
}
