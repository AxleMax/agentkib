      {
        "title": "AgentKib",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 680,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 15, "y": 25 },
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "icon": ["icons/icon.icns"],
    "externalBin": ["binaries/agentkib-quota-sidecar"],
    "resources": {
      "resources/CodexBar_CodexBarCore.bundle/": "CodexBar_CodexBarCore.bundle/",
      "resources/licenses/CodexBar-LICENSE.txt": "licenses/CodexBar-LICENSE.txt"
    }
  }
}
